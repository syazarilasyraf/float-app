<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/projectDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/projectDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/projectProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/projectProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <Button
            android:id="@+id/openFloatButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open in Float" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Materials"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/addMaterialButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/materialsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Steps"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/addStepButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stepsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="References"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/addReferenceButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add Image" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/referencesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="120dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Notes"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/notesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Add notes..."
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minHeight="80dp" />

        <Button
            android:id="@+id/saveNotesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Notes" />
    </LinearLayout>
</ScrollView>
