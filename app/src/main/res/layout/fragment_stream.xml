<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Streaming"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/streamStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Status: OFFLINE"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/serverUrlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Signaling server URL"
        android:inputType="textUri"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/streamStatsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:lineSpacingMultiplier="1.3"
        android:text="Quality: 720p / 30 FPS\nBitrate: 2.5 Mbps"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/startStreamButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Start Stream" />

    <Button
        android:id="@+id/stopStreamButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:enabled="false"
        android:text="Stop Stream" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Viewer link:"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/streamLinkText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#11000000"
        android:padding="10dp"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <Button
        android:id="@+id/copyLinkButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="Copy Link" />

</LinearLayout>
