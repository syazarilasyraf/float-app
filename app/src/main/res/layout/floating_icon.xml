<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingIconRoot"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:background="@drawable/floating_icon_background">

    <ImageView
        android:id="@+id/floatingIconImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:contentDescription="Overlay"
        android:src="@drawable/ic_overlay" />

    <TextView
        android:id="@+id/badgeCounter"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:background="@drawable/badge_background"
        android:gravity="center"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:visibility="gone" />

</FrameLayout>
