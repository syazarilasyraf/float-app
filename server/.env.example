# Float Stream Signaling Server Configuration
PORT=3000
HOST=0.0.0.0

# Public STUN servers (comma-separated)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN server for NAT/firewall fallback
# Format: url|username|credential (comma-separated for multiple)
# If left empty, a free public TURN fallback (Metered Open Relay) is used.
TURN_SERVERS=
